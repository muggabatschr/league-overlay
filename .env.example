# Riot Games API-Key — erforderlich.
# Development-Keys gibt es auf https://developer.riotgames.com
# und laufen nach 24 Stunden ab.
# Server-seitig halten, NICHT als NEXT_PUBLIC_ setzen: die Variable
# waere sonst im Browser-Bundle sichtbar und der Key oeffentlich.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Port fuer `pnpm dev` / `pnpm start` — optional, Default 3000.
# PORT=3000
