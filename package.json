{
  "name": "league-overlay",
  "version": "1.0.1",
  "private": true,
  "description": "Session-Statistik-Overlay für League of Legends in Streamlabs und OBS",
  "author": "muggabatschr <michaelh84@web.de>",
  "license": "MIT",
  "main": "electron/main.js",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node scripts/print-routes.mjs && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icon": "node scripts/make-icon.mjs",
    "build:server": "next build && node scripts/prepare-standalone.mjs",
    "electron": "electron .",
    "dist:win": "pnpm run icon && pnpm run build:server && electron-builder --win --publish never"
  },
  "dependencies": {
    "@types/axios": "^0.14.4",
    "axios": "^1.8.4",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
